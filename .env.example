# Copy to .env and fill with real values. The Secrets Gradle Plugin reads .env
# and exposes these via BuildConfig. This template supplies default (empty) values.
GEMINI_API_KEY=
SOUNDSPIRE_API_BASE_URL=https://app.soundspire.online
GOOGLE_OAUTH_CLIENT_ID=
# iOS-only OAuth client ID (create a separate "iOS" OAuth client in Google Cloud Console
# for bundle id com.soundspire.ios). Leave empty on Android-only builds.
GOOGLE_IOS_CLIENT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
